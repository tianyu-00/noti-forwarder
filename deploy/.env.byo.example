# For a machine that already has PostgreSQL and cloudflared. Copy to .env next to docker-compose.byo.yml.
# Never commit .env.

# Makes plain "docker compose up -d / pull / logs" use the own-database file.
# If your cloudflared is a container on its own network, use instead:
#   COMPOSE_FILE=docker-compose.byo.yml:docker-compose.byo-network.yml
COMPOSE_FILE=docker-compose.byo.yml
# Only for that network add-on: the name of cloudflared's Docker network (docker network ls).
# CLOUDFLARED_NETWORK=

# Names the Docker stack. Pick one and never change it later.
COMPOSE_PROJECT_NAME=notiforwarder

GHCR_OWNER=tianyu-00
# An explicit image tag (a sha-xxxxxxx from the Packages page), or "publish" for the newest build.
VERSION=publish

# Your PostgreSQL (13 or newer, no extensions needed). Create a database and a user that OWNS it
# (see the README), then give the server's connection string. URL-encode special characters in the password.
#   same machine:   postgres://notiforwarder:PASSWORD@host.docker.internal:5432/notiforwarder
#   other machine:  postgres://notiforwarder:PASSWORD@10.0.0.5:5432/notiforwarder?sslmode=require
DATABASE_URL=postgres://notiforwarder:change-me@host.docker.internal:5432/notiforwarder

# Public HTTPS address of your tunnel hostname. Encoded into pairing QR codes.
PUBLIC_URL=https://notiforwarder.example.com
# Dashboard login, created on first start only. The password needs at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Reverse-proxy hops in front of the server: your cloudflared + the web container = 2.
TRUST_PROXY=2

# Where the dashboard container listens on this machine. Keep it on loopback.
# WEB_BIND=127.0.0.1:3000

# --- Push alerts through ntfy (optional): see the main README ---
NTFY_TOPIC=
NTFY_URL=
NTFY_TOKEN=
NTFY_MODE=
NTFY_TYPES=
NTFY_APPS_BLOCK=
NTFY_INCLUDE_BODY=
