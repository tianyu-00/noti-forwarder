# Copy to .env next to docker-compose.byo.yml and fill in the five values marked  <--
COMPOSE_FILE=docker-compose.byo.yml
COMPOSE_PROJECT_NAME=notiforwarder
GHCR_OWNER=tianyu-00
VERSION=publish

DATABASE_URL=postgres://notiforwarder:PASSWORD@host.docker.internal:5432/notiforwarder   # <-- your Postgres
PUBLIC_URL=https://notiforwarder.example.com                                              # <-- your tunnel address
ADMIN_USERNAME=admin                                                                      # <-- dashboard login
ADMIN_PASSWORD=change-me-to-a-long-passphrase                                             # <-- 12+ characters
TRUST_PROXY=2

# Only if your cloudflared is a container on its own Docker network (see the README):
# COMPOSE_FILE=docker-compose.byo.yml:docker-compose.byo-network.yml
# CLOUDFLARED_NETWORK=
