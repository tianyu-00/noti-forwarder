# The three required values. Copy to .env next to docker-compose.byo.yml (or enter them in your
# manager's env panel). Everything else has a default.
DATABASE_URL=postgres://notiforwarder:PASSWORD@192.168.1.10:5432/notiforwarder
PUBLIC_URL=https://notifications.example.com
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Optional (defaults shown):
# ADMIN_USERNAME=admin
# VERSION=latest           # or a sha-xxxxxxx tag to pin a build
# WEB_BIND=3000            # 127.0.0.1:3000 = this machine only
# TRUST_PROXY=2

# Only for a plain `docker compose` run, so it picks this file:
COMPOSE_FILE=docker-compose.byo.yml
COMPOSE_PROJECT_NAME=notiforwarder
