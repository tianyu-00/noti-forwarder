# Copy to .env on the server. Never commit .env.
GHCR_OWNER=tianyu-00
# Explicit image tag: a release (1.2.3), a short SHA or a branch tag. Never rely on latest.
VERSION=edge
# Postgres password (generate with: openssl rand -hex 24). Used by both containers.
POSTGRES_PASSWORD=change-me

# Public HTTPS address phones and the browser use (Cloudflare tunnel hostname). Encoded into pairing QR codes.
PUBLIC_URL=https://notiforwarder.example.com
# Dashboard login, created on first start only (changing these later does not change the user).
# Password must be at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Reverse-proxy hops in front of the server. 2 = cloudflared + the bundled web proxy; 1 if nothing is in front of the web container.
TRUST_PROXY=2

# Cloudflare tunnel token (only if you run the bundled `tunnel` profile).
# Zero Trust dashboard > Networks > Tunnels > your tunnel > the token in the install command.
TUNNEL_TOKEN=
