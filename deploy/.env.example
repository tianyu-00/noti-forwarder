# Copy to .env next to docker-compose.yml (or enter these in your manager's env panel).
# Never commit .env. Only the first two are required; everything else has a default.
PUBLIC_URL=https://notifications.example.com
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Optional (defaults shown):
# ADMIN_USERNAME=admin     # the login is created on the first start only; changing it later does not change the user
# VERSION=latest           # or a sha-xxxxxxx tag to pin a build and roll back
# WEB_BIND=3000            # 127.0.0.1:3000 = this machine only
# TRUST_PROXY=2            # reverse-proxy hops in front of the server: your HTTPS proxy + the bundled web proxy
# SILENT_AFTER_MINUTES=120 # a phone unseen this long shows as quiet; 0 = off
# SECRET_KEY=              # encrypts the two-step secret in the database: openssl rand -base64 32 (keep it, do not change it)
# GHCR_OWNER=tianyu-00

# Names the Docker stack and its data volume. Pick one and never change it later,
# or Docker starts a new, empty database.
COMPOSE_PROJECT_NAME=notiforwarder
