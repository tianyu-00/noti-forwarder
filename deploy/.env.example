# Copy to .env on the server. Never commit .env.
GHCR_OWNER=tianyu-00
# Image tag: a short SHA tag (sha-abc1234) to pin a build, or latest for the newest published one.
# To roll back, set an older SHA tag.
VERSION=latest

# Address phones and the browser use, https:// recommended. Encoded into pairing QR codes.
PUBLIC_URL=https://notiforwarder.example.com
# Dashboard login, created on first start only (changing these later does not change the user).
# Password must be at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Optional: encrypts the two-step login secret in the database (at least 32 characters, e.g. `openssl rand -base64 32`).
# Keep it safe and do not change it: without the right key the server refuses to start while a secret is stored.
# SECRET_KEY=
# Minutes without contact before a phone counts as quiet (default 120, 0 = off). Phones check in every ~15 minutes.
# SILENT_AFTER_MINUTES=120
# Reverse-proxy hops in front of the server. 2 = your HTTPS proxy + the bundled web proxy; 1 if nothing is in front of the web container.
TRUST_PROXY=2

# Names the Docker stack and its data volume. Pick one and never change it later,
# or Docker starts a new, empty database.
# COMPOSE_PROJECT_NAME=notiforwarder

# --- Push alerts to your main phone through ntfy (optional) ---
# Leave NTFY_TOPIC empty to keep push turned off. See the README ("Push alerts with ntfy").
# On the public ntfy.sh the topic is the only protection, so it must be long and random
# (20+ characters), for example:  openssl rand -hex 16
NTFY_TOPIC=
# https://ntfy.sh, or your own ntfy server. Plain http is only accepted for a local server.
NTFY_URL=
# Only for a protected ntfy server: an access token.
NTFY_TOKEN=
# all = every message (default), codes = only messages that contain a 2FA code.
NTFY_MODE=
# Which kinds to push: sms,notification (default both). For example "sms" for texts only.
NTFY_TYPES=
# Apps that never trigger a push: comma list of package names, e.g. com.game,com.news
NTFY_APPS_BLOCK=
# false = the alert says only "New message", with no text, sender, app or code. Default true.
NTFY_INCLUDE_BODY=
