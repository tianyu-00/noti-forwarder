# Copy to .env (git-ignored). Never commit real values.
# The deploy stack has its own file: deploy/.env.example

# --- Server (in use now) ---
PORT=3000

# Injected by Docker build args in CI; leave unset for local dev
# (health reports "dev" / "unknown").
# APP_VERSION=
# GIT_COMMIT=
# BUILD_TIME=

# --- Server ---
DATABASE_URL=postgres://notiforwarder:change-me@localhost:5432/notiforwarder
PUBLIC_URL=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# TRUST_PROXY=1
