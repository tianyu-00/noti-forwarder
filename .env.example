# Copy to .env (git-ignored). Never commit real values.
# The deploy stack has its own file: deploy/.env.example

# --- Server (in use now) ---
PORT=3000

# Injected by Docker build args in CI; leave unset for local dev
# (health reports "dev" / "unknown").
# APP_VERSION=
# GIT_COMMIT=
# BUILD_TIME=

# --- Server (planned, not read by the code yet) ---
# DATABASE_URL=postgres://notiforwarder:change-me@localhost:5432/notiforwarder
# SESSION_SECRET=generate-with: openssl rand -hex 32
# DASHBOARD_ORIGIN=https://notiforwarder.example.com

# --- GitHub Actions repo secrets (set in repo Settings > Secrets, NOT in .env) ---
# DEPLOY_SSH_KEY         private key for the deploy-only SSH user
# DEPLOY_HOST            Ubuntu server hostname or IP
# DEPLOY_USER            SSH user on the server
# RELEASE_PLEASE_TOKEN   PAT so release tags trigger the image build
